APP_NAME=clinic-whatsapp-bot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

REDIS_URL=redis://localhost:6379/0
REDIS_STATE_TTL_SECONDS=2592000
MESSAGE_BUFFER_SECONDS=3
MESSAGE_BUFFER_TTL_SECONDS=300
CONVERSATION_LOCK_TTL_SECONDS=120

HISTORY_LIMIT=20
MAX_OUTBOUND_MESSAGE_LENGTH=850
DEFAULT_TIMEZONE=America/Sao_Paulo

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PATIENT_TABLE=patients
SUPABASE_CONVERSATION_TABLE=conversation_history
SUPABASE_APPOINTMENT_TABLE=appointment_requests

WAHA_BASE_URL=http://localhost:3000
WAHA_SEND_TEXT_PATH=/api/sendText
WAHA_API_KEY=
WAHA_API_KEY_HEADER=X-Api-Key
WAHA_SESSION=default
WAHA_REQUEST_TIMEOUT_SECONDS=15

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=40
GEMINI_TEMPERATURE=0.7

AVAILABLE_DOCTORS=Clinico Geral,Cardiologia,Dermatologia
APPOINTMENT_KEYWORDS=agendar,agendamento,consulta,marcar,horario
HUMAN_HANDOFF_KEYWORDS=atendente,humano,pessoa,suporte,secretaria
RESUME_AI_KEYWORDS=voltar para o bot,reativar ia,retomar atendimento,voltar ao atendimento automatico
AFFIRMATIVE_KEYWORDS=sim,confirmo,pode confirmar,ok,certo
NEGATIVE_KEYWORDS=nao,cancelar,corrigir,voltar
